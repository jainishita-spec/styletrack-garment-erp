# PostgreSQL connection (Railway Postgres plugin gives you this automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/styletrack

# Set to "true" when DB needs SSL (Railway public URL / most cloud DBs). Internal Railway URL works without SSL.
DATABASE_SSL=false

# Port (Railway sets PORT automatically)
PORT=5000

# Random long string used to sign login tokens - CHANGE THIS in production
JWT_SECRET=change-this-to-a-long-random-string

# Frontend URL(s) allowed to call this API (comma separated). Use * only for testing.
CORS_ORIGIN=http://localhost:5173

# First admin user (created automatically on first start if no users exist)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@styletrack.com
ADMIN_PASSWORD=admin123
